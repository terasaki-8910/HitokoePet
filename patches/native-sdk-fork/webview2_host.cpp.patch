+/* App-owned window move (the AppKit host's native_sdk_appkit_move_window
+ * on Win32). The pet's drag/throw physics live in the app: each frame it
+ * calls this with a delta, reads back the applied origin plus the live
+ * cursor and primary-button state, and computes its own release velocity
+ * from the origin samples. Win32's screen space is already the
+ * MoveWindowResult convention (top-left origin, y down, physical pixels),
+ * so no axis flips — unlike AppKit. vx/vy/released stay zero: the app owns
+ * the gesture and needs no host-side velocity telemetry. Only an unknown
+ * window is an error. */
+int native_sdk_windows_move_window(Host *host, uint64_t window_id, double dx, double dy, int clamp, double *out_x, double *out_y, int *out_hit_x, int *out_hit_y, int *out_primary_down, double *out_vx, double *out_vy, int *out_released, double *out_cursor_x, double *out_cursor_y) {
+    if (!host) return 0;
+    auto found = host->windows.find(window_id);
+    if (found == host->windows.end() || !found->second.hwnd) return 0;
+    HWND hwnd = found->second.hwnd;
+    RECT rect = {};
+    if (!GetWindowRect(hwnd, &rect)) return 0;
+    const double w = (double)(rect.right - rect.left);
+    const double h = (double)(rect.bottom - rect.top);
+    double new_x = (double)rect.left + dx;
+    double new_y = (double)rect.top + dy;
+    int hit_x = 0;
+    int hit_y = 0;
+    /* Clamp keeps the whole window inside the monitor's work area (desktop
+     * minus the taskbar), matching AppKit's visibleFrame clamp. */
+    if (clamp) {
+        HMONITOR monitor = MonitorFromWindow(hwnd, MONITOR_DEFAULTTONEAREST);
+        MONITORINFO info = {};
+        info.cbSize = sizeof(info);
+        if (GetMonitorInfoW(monitor, &info)) {
+            const double min_x = (double)info.rcWork.left;
+            const double max_x = (double)info.rcWork.right - w;
+            const double min_y = (double)info.rcWork.top;
+            const double max_y = (double)info.rcWork.bottom - h;
+            if (new_x < min_x) { new_x = min_x; hit_x = 1; }
+            if (new_x > max_x) { new_x = max_x; hit_x = 1; }
+            if (new_y < min_y) { new_y = min_y; hit_y = 1; }
+            if (new_y > max_y) { new_y = max_y; hit_y = 1; }
+        }
+    }
+    const LONG final_x = (LONG)lround(new_x);
+    const LONG final_y = (LONG)lround(new_y);
+    /* SWP_NOZORDER preserves the topmost band so a floating pet stays above
+     * other windows through the drag and throw. */
+    if (dx != 0.0 || dy != 0.0) {
+        SetWindowPos(hwnd, nullptr, final_x, final_y, 0, 0, SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE);
+    }
+    if (out_x) *out_x = (double)final_x;
+    if (out_y) *out_y = (double)final_y;
+    if (out_hit_x) *out_hit_x = hit_x;
+    if (out_hit_y) *out_hit_y = hit_y;
+    if (out_vx) *out_vx = 0.0;
+    if (out_vy) *out_vy = 0.0;
+    if (out_released) *out_released = 0;
+    if (out_primary_down) *out_primary_down = (GetAsyncKeyState(VK_LBUTTON) & 0x8000) ? 1 : 0;
+    POINT cursor = {};
+    if (GetCursorPos(&cursor)) {
+        if (out_cursor_x) *out_cursor_x = (double)cursor.x;
+        if (out_cursor_y) *out_cursor_y = (double)cursor.y;
+    }
+    return 1;
+}
