+/* Right-click menu for a chromeless pet. The runtime's native context-menu
+ * path is off on Win32 (no show_context_menu_fn), so a right-press on the
+ * canvas would otherwise do nothing. Present the app's declared menu (app.zon
+ * `.menus` — Settings / Close Pet, the same verbs the pet's widget context
+ * menu carries) at the cursor and dispatch the pick as a menu command, the
+ * same route the accelerators and a real menu bar use. */
+static void showWindowContextMenu(Host *host, HWND hwnd) {
+    if (!host || !hwnd || host->menus.empty()) return;
+    HMENU menu = CreatePopupMenu();
+    if (!menu) return;
+    for (const Menu &group : host->menus) {
+        for (const MenuItem &item : group.items) {
+            if (item.separator) { AppendMenuW(menu, MF_SEPARATOR, 0, nullptr); continue; }
+            if (item.command_id == 0) continue;
+            UINT flags = MF_STRING;
+            if (!item.enabled) flags |= MF_GRAYED;
+            if (item.checked) flags |= MF_CHECKED;
+            std::wstring label = widen(item.label);
+            AppendMenuW(menu, flags, item.command_id, label.c_str());
+        }
+    }
+    POINT cursor = {};
+    GetCursorPos(&cursor);
+    SetForegroundWindow(hwnd);
+    UINT command_id = TrackPopupMenu(menu, TPM_RETURNCMD | TPM_NONOTIFY | TPM_RIGHTBUTTON, cursor.x, cursor.y, 0, hwnd, nullptr);
+    DestroyMenu(menu);
+    if (command_id != 0) emitMenuCommandForId(host, hwnd, command_id);
+    PostMessageW(hwnd, WM_NULL, 0, 0);
+}
