+/* Menu accelerators as keyboard shortcuts. app.zon menu items carry a
+ * key + modifiers (Close Pet = Ctrl+W, Settings = Ctrl+,); a chromeless pet
+ * shows no menu bar, so no accelerator table drives them. Match a key event
+ * against the declared menu items directly and fire the item's command, so
+ * the accelerators work the same as they do off the macOS menu. */
+static bool emitMenuAcceleratorForWindow(Host *host, HWND hwnd, WPARAM wparam) {
+    if (!host || host->menus.empty()) return false;
+    std::string key = shortcutKeyFromWParam(wparam);
+    if (key.empty()) return false;
+    for (const Menu &menu : host->menus) {
+        for (const MenuItem &item : menu.items) {
+            if (item.separator || item.command_id == 0 || item.key.empty()) continue;
+            if (item.key != key) continue;
+            if (!shortcutModifiersMatch(item.modifiers, false)) continue;
+            return emitMenuCommandForId(host, hwnd, item.command_id);
+        }
+    }
+    return false;
+}
