+/* Resize a window to a new content size (the AppKit host's
+ * native_sdk_appkit_resize_window on Win32). The pet app fits its window
+ * to the sprite's scaled size on launch and every scale change
+ * (fx.resizeWindow), so this must actually apply for the pet's drag
+ * hit-test — which assumes the window IS the sprite — to line up with
+ * what is on screen. bottom_center keeps the bottom edge and horizontal
+ * center fixed, matching AppKit's anchor (a companion sprite grows/shrinks
+ * in place on its ground line instead of hanging from the old top-left).
+ * Win32's origin is already top-left/y-down, so unlike AppKit this needs
+ * no vertical flip: keeping the bottom edge fixed means recomputing top
+ * from the new height directly. */
+int native_sdk_windows_resize_window(Host *host, uint64_t window_id, double width, double height, int anchor_bottom_center) {
+    if (!host || width <= 0 || height <= 0) return 0;
+    auto found = host->windows.find(window_id);
+    if (found == host->windows.end() || !found->second.hwnd) return 0;
+    HWND hwnd = found->second.hwnd;
+    RECT rect = {};
+    if (!GetWindowRect(hwnd, &rect)) return 0;
+    const double old_width = (double)(rect.right - rect.left);
+    const double old_height = (double)(rect.bottom - rect.top);
+    double new_left = (double)rect.left;
+    double new_top = (double)rect.top;
+    if (anchor_bottom_center) {
+        new_left = (double)rect.left + (old_width - width) / 2.0;
+        new_top = (double)rect.top + (old_height - height);
+    }
+    SetWindowPos(hwnd, nullptr, (int)lround(new_left), (int)lround(new_top), (int)lround(width), (int)lround(height), SWP_NOZORDER | SWP_NOACTIVATE);
+    return 1;
+}
