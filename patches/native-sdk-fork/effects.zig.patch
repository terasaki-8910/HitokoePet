+        /// Ask the platform to present the named gpu_surface view's next
+        /// frame as soon as the pacing grid allows, rather than waiting
+        /// for the view's own animation timer to advance. Fire-and-forget
+        /// (a missing service or unknown view is silently ignored, same
+        /// shape as `cancelTimer`) — an app drives a live-tracking loop
+        /// (window drag/throw follow) by calling this every `frame_clock`
+        /// tick for the duration of the gesture, which decouples the
+        /// loop's update rate from the sprite's per-frame duration
+        /// (regularly 100ms+, far coarser than the drag needs to look
+        /// smooth).
+        pub fn requestGpuSurfaceFrame(self: *Self, window_id: platform.WindowId, view_label: []const u8) void {
+            if (self.executor == .fake) return;
+            const services = self.services orelse return;
+            services.requestGpuSurfaceFrame(window_id, view_label) catch {};
+        }
