+        /// Create (or replace) the OS status-bar / notification-area
+        /// icon — macOS menu bar, Windows the "hidden icons" tray flyout,
+        /// Linux the systray protocol. `options.items`' declared
+        /// `command` strings dispatch through the SAME `onCommand` path
+        /// as `.menus` on a click. False under the fake executor, when no
+        /// tray actions are bound, or when the host lacks a tray (Linux
+        /// desktops without one — see `supportsFeature(.tray)` before
+        /// relying on it as the app's only way to reopen/quit).
+        pub fn createTray(self: *Self, options: TrayOptions) bool {
+            if (self.executor == .fake) return false;
+            const binding = self.tray_actions orelse return false;
+            return binding.create_fn(binding.context, options);
+        }
+
+        /// Replace the tray's menu items (e.g. toggling a checkbox
+        /// label) without recreating the icon. Same availability caveats
+        /// as `createTray`.
+        pub fn updateTrayMenu(self: *Self, items: []const TrayMenuItem) bool {
+            if (self.executor == .fake) return false;
+            const binding = self.tray_actions orelse return false;
+            return binding.update_menu_fn(binding.context, items);
+        }
+
+        /// Remove the tray icon. No-op under the fake executor, when no
+        /// tray actions are bound, or when none was ever created.
+        pub fn removeTray(self: *Self) void {
+            if (self.executor == .fake) return;
+            const binding = self.tray_actions orelse return;
+            binding.remove_fn(binding.context);
+        }
