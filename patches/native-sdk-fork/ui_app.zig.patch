+fn effectsCreateTray(context: *anyopaque, options: platform.TrayOptions) bool {
+    const runtime: *Runtime = @ptrCast(@alignCast(context));
+    runtime.createTray(options) catch return false;
+    return true;
+}
+
+fn effectsUpdateTrayMenu(context: *anyopaque, items: []const platform.TrayMenuItem) bool {
+    const runtime: *Runtime = @ptrCast(@alignCast(context));
+    runtime.updateTrayMenu(items) catch return false;
+    return true;
+}
+
+fn effectsRemoveTray(context: *anyopaque) void {
+    const runtime: *Runtime = @ptrCast(@alignCast(context));
+    runtime.removeTray() catch {};
+}
